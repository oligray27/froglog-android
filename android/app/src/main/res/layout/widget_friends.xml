<?xml version="1.0" encoding="utf-8"?>
<!-- FriendsWidget, in the shadcn style shared by all three widgets (default shadcn sizes): up to four friends in rows. Only views RemoteViews allows: a plain View stops the widget loading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/friends_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/friends_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_notification" />

        <TextView
            android:id="@+id/friends_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_title_online_now"
            android:textColor="@color/widget_card_foreground"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/friends_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/widget_secondary_foreground"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- The list scrolls. The empty message is behind it and shows when there are no friends. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/friends_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/friends_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_friends_description"
            android:textColor="@color/widget_muted_foreground"
            android:textSize="21sp" />
    </FrameLayout>
</LinearLayout>
