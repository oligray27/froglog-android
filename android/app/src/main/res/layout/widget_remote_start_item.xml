<?xml version="1.0" encoding="utf-8"?>
<!-- One game in Remote Start's list: a divider above every one after the first, then the cover, the title and when it was last played,
     and a play button (the same solid square as the other widgets' buttons). The whole row starts the game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remote_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/remote_item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/widget_input"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/remote_item_cover"
            android:layout_width="42dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/remote_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_card_foreground"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/remote_item_played"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted_foreground"
                android:textSize="18sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/remote_item_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_button"
            android:padding="12dp"
            android:src="@drawable/ic_widget_play" />
    </LinearLayout>
</LinearLayout>
