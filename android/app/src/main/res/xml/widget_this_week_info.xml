<?xml version="1.0" encoding="utf-8"?>
<!-- Refreshes every 30 minutes, Android's shortest; the site also refreshes it when its Quick Session changes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_this_week_description"
    android:configure="uk.co.froglog.app.widgets.WidgetThemeActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/widget_this_week"
    android:minWidth="250dp"
    android:minHeight="170dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="140dp"
    android:previewImage="@drawable/widget_this_week_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
